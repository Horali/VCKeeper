DISCORD_TOKEN=your_bot_token_here
VOICE_CHANNEL_ID=your_voice_channel_id_here
PORT=8000

# main = voice + chat reply + daily reminder DMs (default)
# backup = voice only; CHAT_CHANNEL_ID and REMINDER_* are ignored and not required
BOT_ROLE=main

# 0 = join with mic/speaker icons on (default), 1 = join muted and deafened
VOICE_MUTED=0

# main only
CHAT_CHANNEL_ID=your_chat_channel_id_here
REMINDER_USER_ID=your_discord_user_id_here
REMINDER_TEST=0

# main only: "@Horaya explain" runs Haiku through Claude Code on your Claude plan.
# Make the token on your own PC with `claude setup-token`. With it set, the bot downloads Claude Code (~330 MB disk)
# on first start; a reply needs ~210 MB of free RAM, so use a host with 512 MB.
CLAUDE_CODE_OAUTH_TOKEN=
EXPLAIN_MODEL=haiku
