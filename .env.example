DISCORD_TOKEN=your_bot_token_here
VOICE_CHANNEL_ID=your_voice_channel_id_here
PORT=8000

# main = voice + chat reply + daily reminder DMs (default)
# backup = voice only; CHAT_CHANNEL_ID and REMINDER_* are ignored and not required
BOT_ROLE=main

# main only
CHAT_CHANNEL_ID=your_chat_channel_id_here
REMINDER_USER_ID=your_discord_user_id_here
REMINDER_TEST=0
